<Project Sdk="Microsoft.NET.Sdk">

  <!-- One source tree, several Jellyfin ABIs. Everything that differs between
       them is a property with a default here, overridden per row by the build
       matrix (.github/workflows/abis.yml). No overrides gives the primary row,
       which is what a local build wants. -->
  <PropertyGroup>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.11.0</JellyfinVersion>
    <!-- Deliberately NOT overridden as TargetFramework: MSBuild strips a global
         TargetFramework before restore, so -p:TargetFramework=net10.0 restores
         the row's packages against the default here and NU1202s. A custom
         property survives restore and then sets the real one. -->
    <JellyfinFramework Condition="'$(JellyfinFramework)' == ''">net9.0</JellyfinFramework>
    <TargetFramework>$(JellyfinFramework)</TargetFramework>
    <!-- <server major.minor>.0.<build>. The build number is shared by every
         row, so a v12 server ranks the v12 zip above the 10.11 one — Jellyfin
         treats targetAbi as a floor and will otherwise offer the older build
         (jellyfin#11331, closed Not A Bug). -->
    <PluginVersion Condition="'$(PluginVersion)' == ''">10.11.0.2</PluginVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
    <FileVersion>$(PluginVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Web\config.html" />
    <EmbeddedResource Include="Web\config.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pin to the OLDEST supported patch of the row's line, and do NOT float. .NET binds
         an assembly reference upward but never downward, so a float resolves to
         whatever was newest on build day and produces a plugin that earlier
         10.11.x servers refuse to load ("references an incompatible version of
         one of the shared libraries"). Verified in the syncplayv2 M0 spike:
         a build against 10.11.11 was rejected by a 10.11.7 server. -->
    <PackageReference Include="Jellyfin.Data" Version="[$(JellyfinVersion)]" />
    <PackageReference Include="Jellyfin.Controller" Version="[$(JellyfinVersion)]" />
    <PackageReference Include="LiteDB" Version="5.0.15" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
