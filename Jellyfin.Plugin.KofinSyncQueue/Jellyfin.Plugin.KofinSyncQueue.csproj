<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyVersion>12.0.0.1</AssemblyVersion>
    <FileVersion>12.0.0.1</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Web\config.html" />
    <EmbeddedResource Include="Web\config.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pin exactly, do NOT float. .NET binds an assembly reference upward but
         never downward, so a float resolves to whatever was newest on build day
         and produces a plugin that older servers of the same line refuse to
         load ("references an incompatible version of one of the shared
         libraries"). Verified in the syncplayv2 M0 spike. -->
    <PackageReference Include="Jellyfin.Data" Version="[12.0.0-rc5]" />
    <PackageReference Include="Jellyfin.Controller" Version="[12.0.0-rc5]" />
    <PackageReference Include="LiteDB" Version="5.0.15" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
